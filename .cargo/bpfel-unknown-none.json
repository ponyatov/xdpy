{
    "llvm-target": "bpfel",
    "data-layout": "e-m:e-p:64:64-i64:64-n32:64-S128",
    "arch": "bpf",
    "target-endian": "little",
    "target-pointer-width": "64",
    "target-c-int-width": "32",
    "os": "none",
    "env": "",
    "vendor": "unknown",
    "linker": "llvm-link",
    "linker-flavor": "ld.lld",
    "executables": true,
    "relocation-model": "static",
    "code-model": "small",
    "disable-redzone": true,
    "frame-pointer": "always",
    "features": "-alu32",
    "dynamic-linking": false,
    "no-compiler-rt": true,
    "position-independent-executables": false,
    "pre-link-args": {
        "ld.lld": ["-z", "max-page-size=4096"]
    },
    "archive-format": "gnu",
    "emit-debug-gdb-scripts": false,
    "requires-uwtable": false,
    "max-atomic-width": 64,
    "singlethread": true
}
{
    "llvm-target": "bpfel",
    "data-layout": "e-m:e-p:64:64-i64:64-n32:64-S128",
    "arch": "bpf",
    "target-endian": "little", 
    "target-pointer-width": "64",
    "target-c-int-width": "32",
    "os": "none",
    "env": "",
    "vendor": "unknown",
    "linker-flavor": "ld.lld",
    "linker": "rust-lld",
    "executables": true,
    "relocation-model": "static",
    "code-model": "kernel",
    "disable-redzone": true,
    "frame-pointer": "all",
    "features": "+alu32",
    "dynamic-linking": false,
    "no-compiler-rt": true,
    "position-independent-executables": false,
    "pre-link-args": {
        "ld.lld": [
            "--script=ebpf.lds",
            "--gc-sections",
            "--build-id=none"
        ]
    },
    "archive-format": "gnu",
    "emit-debug-gdb-scripts": false,
    "requires-uwtable": false,
    "max-atomic-width": 64,
    "singlethread": true
}
